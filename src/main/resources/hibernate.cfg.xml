<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="connection.url">jdbc:mysql://localhost:3306/MaintenanceDept_WMS?useSSL=false&amp;serverTimezone=UTC</property>
        <property name="connection.username">root</property>
        <property name="connection.password">P@ssword123</property>

        <property name="dialect">org.hibernate.dialect.MySQLDialect</property>

        <property name="show_sql">true</property>
        <property name="format_sql">true</property>

        <property name="hbm2ddl.auto">update</property>
        
        <!-- Tell Hibernate to use HikariCP as the connection provider -->
        <property name="hibernate.connection.provider_class">org.hibernate.hikaricp.internal.HikariCPConnectionProvider</property>

        <!-- HikariCP Configuration Settings -->
        <!-- How many connections should stay open and ready (10 is standard for small/medium apps) -->
        <property name="hibernate.hikari.maximumPoolSize">10</property>
        
        <!-- How long to wait for a connection before giving up (30 seconds) -->
        <property name="hibernate.hikari.connectionTimeout">30000</property>
        
        <!-- How long a connection can sit idle in the pool (10 minutes) -->
        <property name="hibernate.hikari.idleTimeout">600000</property>
        
        <!-- Maximum lifetime of a connection in the pool (30 minutes) -->
        <property name="hibernate.hikari.maxLifetime">1800000</property>
        
        <mapping class="vtdi.keniel.filems.models.InvolvedParty"/>
        <mapping class="vtdi.keniel.filems.models.Judge"/>
        <mapping class="vtdi.keniel.filems.models.CourtCase"/>

    </session-factory>
</hibernate-configuration>